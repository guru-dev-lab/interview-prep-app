ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
JWT_SECRET=
GOOGLE_CLIENT_ID=
DATABASE_URL=

# Optional model overrides (defaults: opus=claude-opus-4-8, sonnet=claude-sonnet-5, haiku=claude-haiku-4-5-20251001)
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=

# Live answer streaming is ON by default. Set to 0 to instantly revert to buffered
# (whole-answer-at-once) behavior without a code change.
STREAM_LIVE_ANSWERS=

# Answer-growth is ON by default: when the interviewer keeps elaborating on the SAME
# question, the on-screen answer extends in place instead of waiting or making a new card.
# Set to 0 to disable (revert to the previous 15s-cooldown behavior).
GROW_ANSWERS=

# Pre-generate answers for predicted follow-up questions (ON by default) so they appear
# instantly if asked. Costs a couple extra Haiku calls per answer. Set to 0 to disable.
PREGEN_FOLLOWUPS=

# Per-user voice profile (ON by default): learns how each user speaks from their own
# past interview answers and writes answers in their voice. Strictly per-user. Set to 0
# to disable (falls back to the standard answer style).
VOICE_PROFILE=

# Pointer-style answers (ON by default): non-technical answers are formatted as short
# scannable beats to riff from rather than dense prose. Technical answers stay exact. 0 = off.
POINTERS=

# Coaching points (ON by default): after each answer, surface 2-3 extra beats to also hit
# to make it stronger/clearer. One extra Haiku call per answer. Set to 0 to disable.
COACHING_POINTS=

# Stay silent (ON by default): suppress clearly non-substantive interviewer talk (rapport,
# logistics, "does that make sense?", closing) so the overlay isn't cluttered. Conservative —
# only obvious non-questions are filtered. Set to 0 to surface everything.
STAY_SILENT=
